{
  "CORSRules": [
    {
      "AllowedOrigins": ["https://YOUR-NAME.github.io"],
      "AllowedMethods": ["GET", "PUT", "DELETE"],
      "AllowedHeaders": ["authorization", "content-type", "if-match", "if-none-match", "range", "x-amz-content-sha256", "x-amz-date"],
      "ExposeHeaders": ["ETag", "Date"],
      "MaxAgeSeconds": 3600
    }
  ]
}
